# Ollama server
LOCALSLM_OLLAMA_HOST=http://localhost:11434

# Optional: enables the `--judge claude` opt-in path. Local judging needs nothing.
# ANTHROPIC_API_KEY=

# Optional: enables energy metrics, which shell out to `sudo powermetrics`.
LOCALSLM_ENABLE_POWERMETRICS=false

# API port. 8000 is commonly taken by other local projects.
LOCALSLM_PORT=8420
